,{"name":"content-type","value":"application/json; charset=utf-8"},{"name":"vary","value":"Origin"}],"content":{"size":-1,"mimeType":"application/json; charset=utf-8","text":"{\"success\":true,\"data\":{\"content\":{\"personalInfo\":{\"fullName\":\"Meera Kapoor\",\"email\":\"meera.kapoor.test@example.com\",\"phone\":\"+91 90000 11111\",\"location\":\"Bengaluru, India\",\"linkedin\":\"https://linkedin.com/in/meera-kapoor-test\",\"portfolio\":\"Digital Marketing Manager\",\"yearsOfExperience\":\"6\",\"profilePicture\":\"\",\"dateOfBirth\":\"\",\"nationality\":\"\",\"passport\":\"\",\"passportNo\":\"\",\"passportPlaceOfIssue\":\"\",\"passportDateOfIssue\":\"\",\"passportDateOfExpiry\":\"\",\"maritalStatus\":\"\",\"militaryService\":\"\",\"drivingLicense\":\"\",\"gender\":\"\",\"disability\":\"\",\"visa\":\"\"},\"profileSummary\":\"<p>Digital marketing manager with 6 years of experience running performance marketing, SEO, and lifecycle programs for D2C and B2B SaaS brands. Owns a monthly paid budget of INR 45 lakh across Google Ads and Meta, and has grown qualified pipeline through HubSpot nurture flows, content-led SEO, and disciplined A/B testing.</p>\",\"experience\":[{\"company\":\"Northwind Home Essentials\",\"position\":\"Digital Marketing Manager\",\"startDate\":\"2023-04\",\"endDate\":\"\",\"current\":true,\"location\":\"D2C\",\"description\":\"<ul><li>Own paid acquisition across Google Ads, Meta Ads and YouTube with a monthly budget of INR 45 lakh; cut blended CAC 22% in 12 months.</li><li>Rebuilt the SEO content program around 40 commercial-intent clusters; organic sessions up 68% and revenue share from 11% to 19%.</li><li>Designed HubSpot lifecycle flows (welcome, browse abandon, win-back) that lifted repeat purchase rate by 9 points.</li><li>Introduced a weekly A/B testing cadence for landing pages and creatives; 31 tests shipped, 12 winners rolled out.</li></ul>\",\"id\":\"sec_MTV7YkHr5s\"},{\"company\":\"Brightlane Software\",\"position\":\"Senior Performance Marketing Executive\",\"startDate\":\"2020-07\",\"endDate\":\"2023-03\",\"current\":false,\"location\":\"B2B SaaS\",\"description\":\"<ul><li>Ran Google Search, LinkedIn Ads and retargeting for a USD 12k/month budget; MQL to SQL conversion improved from 18% to 27%.</li><li>Built GA4 + HubSpot attribution dashboards that moved budget from low-intent display to search and webinars.</li><li>Launched a webinar program (14 events) that sourced 23% of new pipeline in FY2022.</li></ul>\",\"id\":\"sec_ONa9fhM-KI\"},{\"company\":\"Lotus Retail Pvt Ltd\",\"position\":\"Marketing Executive\",\"startDate\":\"2018-06\",\"endDate\":\"2020-06\",\"current\":false,\"location\":\"\",\"description\":\"<ul><li>Managed social media calendar, email campaigns and brand assets for 3 regional store launches, achieving {XX%} improvement in key metrics.</li><li>Reported weekly campaign performance in Google Analytics and Excel to the brand manager, achieving {XX%} improvement in key metrics.</li></ul>\",\"id\":\"sec_nBlQH7F5q3\"}],\"education\":[{\"institution\":\"Westbridge School of Management\",\"degree\":\"MBA\",\"field\":\"Marketing\",\"startDate\":\"2016\",\"endDate\":\"2018\",\"description\":\"\",\"id\":\"sec_44xfO37VTB\"},{\"institution\":\"St. Aldric College\",\"degree\":\"B.Com\",\"field\":\"\",\"startDate\":\"2013\",\"endDate\":\"2016\",\"description\":\"\",\"id\":\"sec_LjsL9cCCyi\"}],\"projects\":[{\"name\":\"Festive Season Campaign 2024\",\"description\":\"<ul><li>Planned a 6-week multi-channel campaign (search, Meta, influencers, email); hit 132% of revenue target at 3.4x ROAS.</li></ul>\",\"technologies\":[\"Google Ads\",\"Meta Ads Manager\",\"HubSpot\",\"GA4\",\"Canva\"],\"startDate\":\"\",\"endDate\":\"\",\"id\":\"sec_03jMgbDKfa\"}],\"skills\":[\"SEO\",\"Google Ads\",\"Meta Ads\",\"HubSpot\",\"Google Analytics\",\"Email Marketing\",\"Content Strategy\",\"A/B Testing\",\"Marketing Automation\",\"Brand Management\",\"Excel\",\"Canva\"],\"certificates\":[{\"title\":\"Google 